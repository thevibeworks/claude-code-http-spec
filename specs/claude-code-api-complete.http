### ----------------------------------------------------------------------------
### Worker / session bridge
### ----------------------------------------------------------------------------
# Worker registration, heartbeat, diagnostics and file sync for a remote
# session. The `/worker/*` paths are the same protocol against the worker's own
# base URL, authenticating with `session-jwt`.

# source=axios  auth="teleport-org"  timeout=15000ms
GET {{baseUrl}}/v1/code/sessions/{{id}}/events?limit={{id}}&sort_order=desc
Authorization: Bearer {{accessToken}}
Content-Type: application/json
anthropic-version: {{version}}
anthropic-client-platform: {{clientPlatform}}
x-organization-uuid: {{orgUuid}}
User-Agent: claude-cli/{{cliVersion}} (external, cli)

# source=axios  auth="teleport-org"
GET {{baseUrl}}/v1/code/sessions/{{id}}/file?{{id}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json
anthropic-version: {{version}}
anthropic-client-platform: {{clientPlatform}}
x-organization-uuid: {{orgUuid}}
User-Agent: claude-cli/{{cliVersion}} (external, cli)

# source=axios  timeout=15000ms
GET {{baseUrl}}/v1/code/sessions/{{id}}/remote
Authorization: Bearer {{accessToken}}
anthropic-beta: {{oauthBeta}}
User-Agent: claude-cli/{{cliVersion}} (external, cli)

# source=axios  auth="teleport-org"
PUT {{baseUrl}}/v1/code/sessions/{{id}}/synced_file
Authorization: Bearer {{accessToken}}
Content-Type: application/json
anthropic-version: {{version}}
anthropic-client-platform: {{clientPlatform}}
x-organization-uuid: {{orgUuid}}
User-Agent: claude-cli/{{cliVersion}} (external, cli)

# source=axios  timeout=15000ms
PUT {{baseUrl}}/v1/code/sessions/{{id}}/worker
