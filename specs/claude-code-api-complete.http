### ============================================================================
### SECTION 4: USAGE & BILLING
### ============================================================================

### ----------------------------------------------------------------------------
### 4.1 Get Usage Stats
### ----------------------------------------------------------------------------
# Pattern: rg "api/oauth/usage" cli.js

# @name getUsage
# Requires user:inference AND user:profile. Timeout 5000 ms.
GET {{baseUrl}}/api/oauth/usage
Authorization: Bearer {{accessToken}}
anthropic-beta: {{oauthBeta}}
Content-Type: application/json
User-Agent: claude-code/{{cliVersion}}

### Response:
# {
#   "five_hour":        { "utilization": 45, "resets_at": "2025-01-01T00:00:00Z" },
#   "seven_day":        { "utilization": 23, "resets_at": "..." },
#   "seven_day_sonnet": { "utilization": 12, "resets_at": "..." },
#   "seven_day_opus":   { "utilization":  5, "resets_at": "..." },
#   "extra_usage": {
#     "is_enabled":    true,
#     "used_credits":  1234,   // minor units (cents)
#     "monthly_limit": 5000,   // minor units (cents)
#     "utilization":   24
#   }
# }
# utilization is a percentage (0-100), not a 0-1 ratio.

### ----------------------------------------------------------------------------
### 4.2 Get First Token Date
### ----------------------------------------------------------------------------
# Pattern: rg "first_token_date" cli.js

# @name getFirstTokenDate
# Timeout 10000 ms. Called once after a subscription login, only when not
# already cached; skipped on the console/API-key login branch.
GET {{baseUrl}}/api/organization/claude_code_first_token_date
Authorization: Bearer {{accessToken}}
anthropic-beta: {{oauthBeta}}
User-Agent: claude-code/{{cliVersion}}

### Response:
# {
#   "first_token_date": "2025-01-01T00:00:00Z"
# }

### ----------------------------------------------------------------------------
### 4.3 Check Sonnet 1M Access (REMOVED in v2.1.63)
### ----------------------------------------------------------------------------
# Pattern: rg "claude_code_sonnet_1m_access" cli.js
# NOTE: Endpoint removed in v2.1.63 - no longer present in cli.js
# Previously: GET /api/organization/{orgId}/claude_code_sonnet_1m_access

### ----------------------------------------------------------------------------
### 4.4 Create Extra Usage Admin Request
### ----------------------------------------------------------------------------
# Pattern: rg "admin_requests" cli.js

# @name createAdminRequest
POST {{baseUrl}}/api/oauth/organizations/{{orgUuid}}/admin_requests
Authorization: Bearer {{accessToken}}
Content-Type: application/json
anthropic-version: {{version}}
x-organization-uuid: {{orgUuid}}

{
    "request_type": "limit_increase",
    "details": null
}

### Response:
# (CLI ignores response body; server returns JSON)

### ----------------------------------------------------------------------------
### 4.5 List My Admin Requests
### ----------------------------------------------------------------------------
# Pattern: rg "admin_requests/me" cli.js

# @name listMyAdminRequests
GET {{baseUrl}}/api/oauth/organizations/{{orgUuid}}/admin_requests/me?request_type=limit_increase&statuses=pending&statuses=dismissed
Authorization: Bearer {{accessToken}}
Content-Type: application/json
anthropic-version: {{version}}
x-organization-uuid: {{orgUuid}}

### Response:
# [ ... ]

### ----------------------------------------------------------------------------
### 4.6 Check Admin Request Eligibility (NEW in v2.1.76)
### ----------------------------------------------------------------------------
# Pattern: rg "admin_requests/eligibility" cli.js

# @name checkAdminRequestEligibility
GET {{baseUrl}}/api/oauth/organizations/{{orgUuid}}/admin_requests/eligibility?request_type=limit_increase
Authorization: Bearer {{accessToken}}
Content-Type: application/json
anthropic-version: {{version}}
x-organization-uuid: {{orgUuid}}

### Response:
# { "is_allowed": boolean }
# Compared with a strict === false, so missing/null fails OPEN.
#
# All three admin_requests calls use the session header builder:
# anthropic-version + x-organization-uuid, and NO anthropic-beta and NO
# User-Agent. They are OAuth-only (an API key is rejected upstream), have
# no timeout, no retry, and inspect no status code.


