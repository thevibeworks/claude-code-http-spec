### ----------------------------------------------------------------------------
### Design (Claude Design integration)
### ----------------------------------------------------------------------------
# Consent and grant management plus an MCP handshake. `/v1/design/mcp` is
# `auth: "none"` with a 60s timeout -- it carries its own grant token. The
# consent GET is a pre-flight; on failure the client falls back to a 403-seeded
# cache rather than blocking.

# source=axios
DELETE {{baseUrl}}/v1/design/consent
Authorization: Bearer {{accessToken}}
anthropic-beta: {{oauthBeta}}
User-Agent: claude-cli/{{cliVersion}} (external, cli)

# source=axios
GET {{baseUrl}}/v1/design/consent
Authorization: Bearer {{accessToken}}
anthropic-beta: {{oauthBeta}}
User-Agent: claude-cli/{{cliVersion}} (external, cli)

# source=axios
POST {{baseUrl}}/v1/design/consent
Authorization: Bearer {{accessToken}}
anthropic-beta: {{oauthBeta}}
User-Agent: claude-cli/{{cliVersion}} (external, cli)

# source=axios
GET {{baseUrl}}/v1/design/grants
Authorization: Bearer {{accessToken}}
anthropic-beta: {{oauthBeta}}
User-Agent: claude-cli/{{cliVersion}} (external, cli)

# source=axios
POST {{baseUrl}}/v1/design/grants
Authorization: Bearer {{accessToken}}
anthropic-beta: {{oauthBeta}}
User-Agent: claude-cli/{{cliVersion}} (external, cli)

# source=axios  auth="none"  timeout=60000ms
POST {{baseUrl}}/v1/design/mcp
Accept: application/json
User-Agent: claude-cli/{{cliVersion}} (external, cli)


