### ============================================================================
### SECTION 6: HEALTH & CONNECTIVITY
### ============================================================================

### ----------------------------------------------------------------------------
### 6.1 API Health Check
### ----------------------------------------------------------------------------
# Pattern: rg "api/hello" cli.js
# v2.1.76: connectivity checks use both BASE_API_URL/api/hello AND origin/v1/oauth/hello

# @name healthCheck
# CORRECTED v2.1.76: no Cache-Control is sent. The only header is the
# claude-cli User-Agent form. No auth. Success is strictly HTTP 200.
# Both probes below run CONCURRENTLY at startup; either failing aborts
# the preflight. The /v1/oauth/hello host is derived from TOKEN_URL, so
# it follows CLAUDE_CODE_CUSTOM_OAUTH_URL when that is set.
GET {{baseUrl}}/api/hello
User-Agent: claude-cli/{{cliVersion}} (external, cli)

### ----------------------------------------------------------------------------
### 6.2 OAuth Health Check
### ----------------------------------------------------------------------------
# Pattern: rg "oauth/hello" cli.js
# v2.1.76: also used in connectivity probes alongside /api/hello

# @name oauthHealthCheck
GET {{platformUrl}}/v1/oauth/hello
User-Agent: claude-cli/{{cliVersion}} (external, cli)

### ----------------------------------------------------------------------------
### 6.3 Network Reachability Probe (HEAD) - CORRECTED
### ----------------------------------------------------------------------------
# Pattern: rg '\.head\(' cli.js
#
# PHANTOM REMOVED: earlier revisions documented `HEAD {{baseUrl}}/api/hello`.
# The only .head() call in the bundle targets Cloudflare's resolver, not an
# Anthropic host. It is a generic "am I online" check with a 1s timeout,
# used to decide whether the CLI has any network at all.

# @name networkReachabilityProbe
HEAD http://1.1.1.1

### ----------------------------------------------------------------------------
### 6.3 Parameterized Hello (NEW in v2.1.139)
### ----------------------------------------------------------------------------

# NOT RUNNABLE. `:name` is a literal route-parameter placeholder in the
# binary's constant pool, not a value the CLI interpolates. No call site is
# readable for it (absent from every cli.js-era build through v2.1.76), so
# method/headers/body are not claimed. Recorded as a literal only - same
# class as the /api/oauth/organizations/:orgUUID/* templates.
#   GET {{baseUrl}}/api/hello/:name

### ----------------------------------------------------------------------------
### 6.4 User Lookup (NEW in v2.1.139)
### ----------------------------------------------------------------------------

# @name getUserById
GET {{baseUrl}}/api/users/:id
Authorization: Bearer {{accessToken}}


### ============================================================================
### SECTION 7: MESSAGES API (SDK)
### ============================================================================
# Pattern: rg '"/v1/messages"' cli.js

### ----------------------------------------------------------------------------
### 7.1 Create Message
### ----------------------------------------------------------------------------
# Pattern: rg "post.*v1/messages" cli.js
# v2.1.63: interleaved-thinking GA, many betas graduated
# v2.1.76: claude-opus-4-1 added
# Known models: claude-opus-4-6, claude-sonnet-4-6, claude-opus-4-1, claude-opus-4-1-20250805

# @name createMessage
POST {{baseUrl}}/v1/messages?beta=true
Content-Type: application/json
x-api-key: {{apiKey}}
anthropic-version: {{version}}
anthropic-beta: compact-2026-01-12,context-1m-2025-08-07
X-Stainless-Lang: js
X-Stainless-Package-Version: {{stainlessVersion}}
X-Stainless-OS: Linux
X-Stainless-Arch: x64
X-Stainless-Runtime: node
X-Stainless-Runtime-Version: v22.0.0

{
    "model": "claude-sonnet-4-6",
    "max_tokens": 8192,
    "messages": [
        {
            "role": "user",
            "content": "Hello, Claude!"
        }
    ],
    "stream": false
}

### ----------------------------------------------------------------------------
### 7.2 Create Message (Streaming)
### ----------------------------------------------------------------------------
# Pattern: rg "stream.*true" cli.js

# @name createMessageStream
POST {{baseUrl}}/v1/messages?beta=true
Content-Type: application/json
x-api-key: {{apiKey}}
anthropic-version: {{version}}
anthropic-beta: compact-2026-01-12
X-Stainless-Helper-Method: stream

{
    "model": "claude-sonnet-4-6",
    "max_tokens": 8192,
    "messages": [
        {
            "role": "user",
            "content": "Hello!"
        }
    ],
    "stream": true
}

