### Self-hosted runner pool
### ----------------------------------------------------------------------------
# Runner registration, spawn-hint polling and session release for the
# SELF_HOSTED_RUNNER_* deployment mode added in v2.1.234. Long-poll endpoints use
# a 30s timeout; the rest 15s.

# source=axios
POST {{baseUrl}}/v1/code/runners/self-hosted/deregister
Authorization: Bearer {{accessToken}}
anthropic-beta: {{oauthBeta}}
