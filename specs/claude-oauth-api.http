# Claude Code OAuth API Reference
# Compatible with: VS Code REST Client, JetBrains HTTP Client
#
# ============================================================================
# SOURCE OF TRUTH
# ============================================================================
# Wire detail (methods, headers, bodies, timeouts, status handling) is read
# from the last release that shipped a readable bundle:
#
#   @anthropic-ai/claude-code@2.1.76  ->  package/cli.js (prettier-formatted)
#
# Since v2.1.117 the release ships as a Bun-compiled binary. Path literals
# still live in the constant pool, so continuity of each PATH below is
# re-checked against extractions/v2.1.197/raw/paths.txt. Continuity of
# HEADERS and BODIES past v2.1.76 is NOT claimed -- see CONFIDENCE below.
#
# ============================================================================
# CONFIDENCE MARKERS (per README.md "Confidence Model")
# ============================================================================
#   [literal]  String exists verbatim in the release. Verify with the
#              `# Verify:` line under each section.
#   [context]  Method / headers / body read from the code window around the
#              literal. True for v2.1.76; re-verify against newer builds.
#   [absent]   Deliberately recorded negative -- checked for, not found.
#
# Verify any single line:
#   rg '/api/oauth/profile' package/cli.js
#   strings binary_2.1.197/claude | rg '/api/oauth/profile'

### ============================================================================
### VARIABLES
### ============================================================================

@baseApiUrl = https://api.anthropic.com
@platformUrl = https://platform.claude.com
@claudeAiUrl = https://claude.ai
@clientId = 9d1c250a-e61b-44d9-88ed-5944d1962f5e
@cliVersion = 2.1.76
@oauthBeta = oauth-2025-04-20
@apiVersion = 2023-06-01

# PKCE (see section 3 for exact generation)
@codeVerifier = REPLACE_WITH_BASE64URL_32_RANDOM_BYTES
@codeChallenge = REPLACE_WITH_BASE64URL_SHA256_OF_VERIFIER
@state = REPLACE_WITH_BASE64URL_32_RANDOM_BYTES

# From callback after authorization
@authCode = YOUR_AUTH_CODE_HERE
@accessToken = YOUR_ACCESS_TOKEN_HERE
@refreshToken = YOUR_REFRESH_TOKEN_HERE
@apiKey = YOUR_API_KEY_HERE

@port = 8765
@orgUuid = YOUR_ORG_UUID
@accountUuid = YOUR_ACCOUNT_UUID
@fileUuid = YOUR_FILE_UUID

### ============================================================================
### 0. AUTH MODEL: WHERE THE TOKEN COMES FROM
### ============================================================================
# Verify: rg 'CLAUDE_CODE_OAUTH_TOKEN|CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR' cli.js
#
# Token source precedence, highest first:              [context]
#
#   1. CLAUDE_CODE_OAUTH_TOKEN                 env var, raw access token
#   2. CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR env var, numeric fd to read
#                                              token from (avoids argv/env leak)
#   3. Managed/primary API key path
#   4. Credentials store -> `claudeAiOauth` record
#
# Tokens supplied via (1) or (2) are synthesized locally with
# scopes = ["user:inference"] only. They therefore do NOT satisfy the
# `user:profile` gate, which is why `claude setup-token` output cannot be
# used for org verification (see section 22).
#
# The persisted credential record is:                  [context]
#   claudeAiOauth: {
#     accessToken, refreshToken, expiresAt (epoch ms),
#     scopes: string[], subscriptionType, rateLimitTier
#   }
#
# Headless login without a browser:                    [context]
#   CLAUDE_CODE_OAUTH_REFRESH_TOKEN   refresh token to bootstrap from
#   CLAUDE_CODE_OAUTH_SCOPES          REQUIRED alongside it; space-separated
#                                     scopes the refresh token was issued with
# CLI errors out if the refresh token is set without the scopes var.
#
# Pre-seeding account identity (skips a profile fetch): [context]
#   CLAUDE_CODE_ACCOUNT_UUID
#   CLAUDE_CODE_USER_EMAIL
#   CLAUDE_CODE_ORGANIZATION_UUID
# All three must be set together. A successful profile fetch overrides them.
#
# Global traffic kill switch:                          [context]
#   CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC
# Suppresses: client_data, account/settings, claude_code_grove, referral
# eligibility prefetch, error reporting. Does NOT suppress: profile, token
# exchange/refresh, roles, usage.

### ============================================================================
### 1. ENDPOINT CONFIGURATION
### ============================================================================
# Verify: rg 'BASE_API_URL|CONSOLE_AUTHORIZE_URL|TOKEN_URL|API_KEY_URL' cli.js
#
# The CLI resolves one config record at startup. Build env is hardcoded to
# "prod"; the "local" record exists but is unreachable in published builds.
#
# PROD:                                                [literal]
#   BASE_API_URL           https://api.anthropic.com
#   CONSOLE_AUTHORIZE_URL  https://platform.claude.com/oauth/authorize
#   CLAUDE_AI_AUTHORIZE_URL https://claude.ai/oauth/authorize
#   TOKEN_URL              https://platform.claude.com/v1/oauth/token
#   API_KEY_URL            https://api.anthropic.com/api/oauth/claude_cli/create_api_key
#   ROLES_URL              https://api.anthropic.com/api/oauth/claude_cli/roles
#   CONSOLE_SUCCESS_URL    https://platform.claude.com/buy_credits?returnUrl=/oauth/code/success%3Fapp%3Dclaude-code
#   CLAUDEAI_SUCCESS_URL   https://platform.claude.com/oauth/code/success?app=claude-code
#   MANUAL_REDIRECT_URL    https://platform.claude.com/oauth/code/callback
#   CLIENT_ID              9d1c250a-e61b-44d9-88ed-5944d1962f5e
#   OAUTH_FILE_SUFFIX      ""
#   MCP_PROXY_URL          https://mcp-proxy.anthropic.com
#   MCP_PROXY_PATH         /v1/mcp/{server_id}
#
# LOCAL (dead branch, recorded for completeness):      [literal]
#   BASE_API_URL           http://localhost:3000
#   CLAUDE_AI_AUTHORIZE_URL http://localhost:4000/oauth/authorize
#   CLIENT_ID              22422756-60c9-4084-8eb7-27705fd5cf9a
#   OAUTH_FILE_SUFFIX      "-local-oauth"
#   MCP_PROXY_PATH         /v1/toolbox/shttp/mcp/{server_id}
#
# OVERRIDES:                                           [context]
#   CLAUDE_CODE_OAUTH_CLIENT_ID   replaces CLIENT_ID, unvalidated
#   CLAUDE_CODE_CUSTOM_OAUTH_URL  replaces BASE_API_URL and rebuilds every
#                                 derived URL; trailing slash stripped;
#                                 sets OAUTH_FILE_SUFFIX to "-custom-oauth"
#
# CLAUDE_CODE_CUSTOM_OAUTH_URL is ALLOWLISTED. Any other value throws
# "CLAUDE_CODE_CUSTOM_OAUTH_URL is not an approved endpoint."
# Allowlist (exact match after trailing-slash strip):  [literal]
#   https://beacon.claude-ai.staging.ant.dev
#   https://claude.fedstart.com
#   https://claude-staging.fedstart.com
#
# When the custom URL is set, derived URLs differ from prod in shape:
#   TOKEN_URL     -> {custom}/v1/oauth/token
#   AUTHORIZE     -> {custom}/oauth/authorize   (both console and claude.ai)
#   SUCCESS_URL   -> {custom}/oauth/code/success?app=claude-code
#                    (no buy_credits detour, unlike prod console)
#
# ANTHROPIC_BASE_URL is a SEPARATE override and does NOT affect OAuth config.
# It is consulted by the inference client and by the file-upload host only
# (section 19) -- an asymmetry worth knowing when proxying.

### ============================================================================
### 2. SCOPES
### ============================================================================
# Verify: rg '"user:inference"|"user:profile"|"user:sessions:claude_code"' cli.js
# Verify: rg '"user:mcp_servers"|"user:file_upload"|"org:create_api_key"' cli.js
#
# Three named sets exist:                              [literal]
#
# CONSOLE set (org:create_api_key + profile):
#   org:create_api_key
#   user:profile
#
# SESSION set (sent on token refresh when no explicit scopes given):
#   user:profile
#   user:inference
#   user:sessions:claude_code
#   user:mcp_servers
#   user:file_upload
#
# ALL set (union of the two, sent on a full interactive login):
#   org:create_api_key
#   user:profile
#   user:inference
#   user:sessions:claude_code
#   user:mcp_servers
#   user:file_upload
#
# INFERENCE-ONLY set (`claude setup-token`):
#   user:inference
#
# Scope semantics used by the client:                  [context]
#   user:inference  -> presence marks the token as a Claude.ai subscription
#                      token. Gates: /api/oauth/usage, first_token_date,
#                      grove, referral, extra-usage. Absence routes login
#                      to the create-api-key branch instead.
#   user:profile    -> gates /api/oauth/usage and client_data client-side.
#   user:mcp_servers, user:file_upload
#                   -> requested and refreshed, but NEVER checked
#                      client-side. Enforcement is server-side only.
#
# NOTE: user:mcp_servers and user:file_upload are absent from pre-v2.1.x
# spec revisions of this file. They are present in v2.1.76.

### ============================================================================
### 3. PKCE GENERATION
### ============================================================================
# Verify: rg 'randomBytes\(32\)|createHash\("sha256"\)' cli.js
#
# base64url = base64, then +/ -> -_ , then strip all '='.  [context]
#
#   code_verifier  = base64url(randomBytes(32))          -> 43 chars
#   code_challenge = base64url(sha256(code_verifier))    -> 43 chars
#   state          = base64url(randomBytes(32))          -> 43 chars
#
# The challenge hashes the ALREADY-ENCODED verifier string (not raw bytes).
#
# Python:
#   import secrets, hashlib, base64
#   b64 = lambda b: base64.urlsafe_b64encode(b).decode().rstrip('=')
#   verifier  = b64(secrets.token_bytes(32))
#   challenge = b64(hashlib.sha256(verifier.encode()).digest())
#   state     = b64(secrets.token_bytes(32))

### ============================================================================
### 4. AUTHORIZATION URL (browser redirect, not an API call)
### ============================================================================
# Verify: rg 'oauth/authorize' cli.js
# Verify: rg 'code_challenge_method|login_hint|login_method' cli.js
#
# Query params, in the order the CLI appends them:      [context]
#   code                  always the literal string "true"
#   client_id             CLIENT_ID
#   response_type         always "code"
#   redirect_uri          MANUAL_REDIRECT_URL, or http://localhost:{port}/callback
#   scope                 space-joined; INFERENCE-ONLY set or ALL set
#   code_challenge        base64url(sha256(verifier))
#   code_challenge_method always "S256"
#   state                 base64url(32 random bytes)
#   orgUUID               optional; only when caller supplies an org
#   login_hint            optional; email, from `claude auth login --email`
#   login_method          optional; only observed literal is "sso",
#                         set by `claude auth login --sso`
#
# Host selection: claude.ai when loginWithClaudeAi, else platform.claude.com.
# BOTH a manual-redirect and a localhost-redirect URL are built each run:
# the manual one is printed for copy/paste, the localhost one is opened in
# the browser. Whichever completes first wins.

# @name authorize_claudeai_full_scopes
# Interactive `claude auth login` -- automatic localhost callback
GET {{claudeAiUrl}}/oauth/authorize
    ?code=true
    &client_id={{clientId}}
    &response_type=code
    &redirect_uri=http://localhost:{{port}}/callback
    &scope=org:create_api_key user:profile user:inference user:sessions:claude_code user:mcp_servers user:file_upload
    &code_challenge={{codeChallenge}}
    &code_challenge_method=S256
    &state={{state}}

###

# @name authorize_claudeai_manual_full_scopes
# Same login, manual copy/paste callback
GET {{claudeAiUrl}}/oauth/authorize
    ?code=true
    &client_id={{clientId}}
    &response_type=code
    &redirect_uri=https://platform.claude.com/oauth/code/callback
    &scope=org:create_api_key user:profile user:inference user:sessions:claude_code user:mcp_servers user:file_upload
    &code_challenge={{codeChallenge}}
    &code_challenge_method=S256
    &state={{state}}

###

# @name authorize_setup_token_inference_only
# `claude setup-token` -- inference scope only, claude.ai host, 1-year token
GET {{claudeAiUrl}}/oauth/authorize
    ?code=true
    &client_id={{clientId}}
    &response_type=code
    &redirect_uri=https://platform.claude.com/oauth/code/callback
    &scope=user:inference
    &code_challenge={{codeChallenge}}
    &code_challenge_method=S256
    &state={{state}}

###

# @name authorize_platform_console
# Console/platform host (loginWithClaudeAi = false)
GET {{platformUrl}}/oauth/authorize
    ?code=true
    &client_id={{clientId}}
    &response_type=code
    &redirect_uri=https://platform.claude.com/oauth/code/callback
    &scope=org:create_api_key user:profile user:inference user:sessions:claude_code user:mcp_servers user:file_upload
    &code_challenge={{codeChallenge}}
    &code_challenge_method=S256
    &state={{state}}
    &orgUUID={{orgUuid}}

###

# @name authorize_sso_with_login_hint
# `claude auth login --email user@example.com --sso`
GET {{claudeAiUrl}}/oauth/authorize
    ?code=true
    &client_id={{clientId}}
    &response_type=code
    &redirect_uri=http://localhost:{{port}}/callback
    &scope=org:create_api_key user:profile user:inference user:sessions:claude_code user:mcp_servers user:file_upload
    &code_challenge={{codeChallenge}}
    &code_challenge_method=S256
    &state={{state}}
    &login_hint=user@example.com
    &login_method=sso

### ============================================================================
### 5. CALLBACK HANDLING
### ============================================================================
# Verify: rg 'Invalid state parameter|Authorization code not found' cli.js
#
# AUTOMATIC MODE -- local HTTP server                  [context]
#   Binds to "localhost" on an OS-assigned ephemeral port (listen(0)).
#   Only the path /callback is served; anything else -> 404.
#   Reads ?code and ?state from the query string.
#     missing code       -> 400 "Authorization code not found"
#     state mismatch     -> 400 "Invalid state parameter"
#     ok                 -> response held open, then 302 to a success URL
#   Success redirect target depends on the granted scopes:
#     scopes include user:inference -> CLAUDEAI_SUCCESS_URL
#     otherwise                     -> CONSOLE_SUCCESS_URL
#   Error redirect always targets CLAUDEAI_SUCCESS_URL.
#
# MANUAL MODE -- copy/paste                            [context]
#   The page at MANUAL_REDIRECT_URL shows a single string the user pastes
#   back into the CLI. Format is:
#
#       <authorization_code>#<state>
#
#   split on the FIRST "#". Either half empty -> "Invalid code. Please make
#   sure the full code was copied".

### ============================================================================
### 6. TOKEN EXCHANGE (authorization_code)
### ============================================================================
# Verify: rg 'grant_type.*authorization_code' cli.js
# Verify: rg '/v1/oauth/token' cli.js
#
# Method   POST                                        [context]
# Auth     none (public client + PKCE)
# Headers  Content-Type: application/json  <- the ONLY header set
# Timeout  15000 ms
# Body     JSON (NOT form-encoded)
#
# Status handling:                                     [context]
#   200  -> success
#   401  -> "Authentication failed: Invalid authorization code"
#   else -> "Token exchange failed ({status}): {statusText}"
#
# `redirect_uri` MUST match the authorize request exactly.
# `expires_in` is sent only in setup-token mode (31536000 = 1 year).
# `state` is echoed back in the body -- unusual for RFC 6749, but the CLI
# sends it on every exchange.

# @name token_exchange_automatic
# Interactive login via localhost callback
POST {{platformUrl}}/v1/oauth/token
Content-Type: application/json

{
    "grant_type": "authorization_code",
    "code": "{{authCode}}",
    "redirect_uri": "http://localhost:{{port}}/callback",
    "client_id": "{{clientId}}",
    "code_verifier": "{{codeVerifier}}",
    "state": "{{state}}"
}

###

# @name token_exchange_manual
# Interactive login via copy/paste callback
POST {{platformUrl}}/v1/oauth/token
Content-Type: application/json

{
    "grant_type": "authorization_code",
    "code": "{{authCode}}",
    "redirect_uri": "https://platform.claude.com/oauth/code/callback",
    "client_id": "{{clientId}}",
    "code_verifier": "{{codeVerifier}}",
    "state": "{{state}}"
}

###

# @name token_exchange_setup_token
# `claude setup-token` -- explicit 1-year expiry
POST {{platformUrl}}/v1/oauth/token
Content-Type: application/json

{
    "grant_type": "authorization_code",
    "code": "{{authCode}}",
    "redirect_uri": "https://platform.claude.com/oauth/code/callback",
    "client_id": "{{clientId}}",
    "code_verifier": "{{codeVerifier}}",
    "state": "{{state}}",
    "expires_in": 31536000
}

### Response (fields the client actually reads):        [context]
# {
#   "access_token":  "string",
#   "refresh_token": "string | null",
#   "expires_in":    3600,
#   "scope":         "space separated scopes",
#   "account": {
#     "uuid":          "string",
#     "email_address": "string"
#   },
#   "organization": {
#     "uuid": "string"
#   }
# }
#
# NOTE the naming split: the TOKEN response uses account.email_address;
# the PROFILE response (section 8) uses account.email. They are different
# field names on different endpoints.
# `account` and `organization` are optional -- when absent the client falls
# back to the profile endpoint for identity.

### ============================================================================
### 7. TOKEN REFRESH (refresh_token)
### ============================================================================
# Verify: rg 'grant_type.*refresh_token' cli.js
#
# Method   POST                                        [context]
# Headers  Content-Type: application/json  <- the ONLY header set
# Timeout  15000 ms
# Status   non-200 -> "Token refresh failed: {statusText}"
#
# SCOPE PARAMETER -- the client always sends `scope`:  [context]
#   If the stored token carries user:inference, the client sends the full
#   SESSION set (5 scopes) regardless of what was originally granted.
#   Otherwise it echoes the token's own recorded scopes.
#
# REFRESH TRIGGER                                      [context]
#   Considered expired when  Date.now() + 300000 >= expiresAt
#   i.e. a 5-minute skew window before actual expiry.
#
# CONCURRENCY -- cross-process file lock                [context]
#   Refresh is serialized by a lock file in the config dir.
#   On ELOCKED: retry up to 5 times, sleeping 1000 + random(0..1000) ms.
#   After the lock is acquired the credential file is re-read; if another
#   process already refreshed, this one no-ops ("race resolved").
#   In-process, concurrent refreshes for the same token are deduped by a
#   promise map.
#
# 401 RECOVERY                                          [context]
#   On a 401 from an API call, the client re-reads the credential store
#   first. If the stored access token differs from the one that failed,
#   another process refreshed it -- retry with the new one, no network call.
#   Only if it matches does an actual refresh fire.

# @name token_refresh
POST {{platformUrl}}/v1/oauth/token
Content-Type: application/json

{
    "grant_type": "refresh_token",
    "refresh_token": "{{refreshToken}}",
    "client_id": "{{clientId}}",
    "scope": "user:profile user:inference user:sessions:claude_code user:mcp_servers user:file_upload"
}

### Response:                                           [context]
# {
#   "access_token":  "string",
#   "refresh_token": "string",   // may be absent -> old one is reused
#   "expires_in":    3600,
#   "scope":         "space separated scopes",
#   "account":       { "uuid": "...", "email_address": "..." },  // optional
#   "organization":  { "uuid": "..." }                           // optional
# }
#
# After a successful refresh the client conditionally re-fetches the profile
# (section 8) -- only if billingType / accountCreatedAt / subscriptionCreatedAt
# / subscriptionType / rateLimitTier are not all already cached.

### ============================================================================
### 8. PROFILE
### ============================================================================
# Verify: rg '/api/oauth/profile' cli.js
#
# Method   GET                                         [context]
# Headers  Authorization: Bearer <token>
#          Content-Type: application/json
#          (no anthropic-beta, no anthropic-version, no User-Agent)
# Timeout  10000 ms
# Errors   swallowed -- any failure returns undefined, no status inspected

# @name get_profile
GET {{baseApiUrl}}/api/oauth/profile
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### Response (every field the client reads):            [context]
# {
#   "account": {
#     "uuid":         "string",
#     "email":        "string",
#     "display_name": "string | null",
#     "created_at":   "ISO-8601 string"
#   },
#   "organization": {
#     "uuid":                    "string",
#     "organization_type":       "claude_max | claude_pro | claude_enterprise | claude_team",
#     "rate_limit_tier":         "string | null",
#     "has_extra_usage_enabled": "boolean | null",
#     "billing_type":            "string | null",
#     "subscription_created_at": "ISO-8601 string | null"
#   }
# }
#
# organization_type -> subscriptionType mapping:        [context]
#   claude_max        -> "max"
#   claude_pro        -> "pro"
#   claude_enterprise -> "enterprise"
#   claude_team       -> "team"
#   anything else     -> null
#
# billing_type literals seen in the bundle:             [literal]
#   stripe_subscription
#   stripe_subscription_contracted
#   apple_subscription
#   google_play_subscription
#
# The profile does NOT return an organization name.     [absent]
# organization_name comes from the roles endpoint (section 9).

### ============================================================================
### 9. USER ROLES
### ============================================================================
# Verify: rg 'ROLES_URL|claude_cli/roles' cli.js
#
# Method   GET                                         [context]
# Headers  Authorization: Bearer <token>   <- the ONLY header
# Timeout  none (axios default: no timeout)
# Status   non-200 -> "Failed to fetch user roles: {statusText}"
# Called   once, immediately after login, before the API-key branch

# @name get_roles
GET {{baseApiUrl}}/api/oauth/claude_cli/roles
Authorization: Bearer {{accessToken}}

### Response:                                           [context]
# {
#   "organization_role": "string",
#   "workspace_role":    "string",
#   "organization_name": "string"
# }
#
# organization_role values the client branches on:      [literal]
#   admin, billing, owner, primary_owner
# (a role outside this set is treated as unprivileged)

### ============================================================================
### 10. CREATE API KEY
### ============================================================================
# Verify: rg 'API_KEY_URL|create_api_key' cli.js
#
# Method   POST                                        [context]
# Headers  Authorization: Bearer <token>   <- the ONLY header
# Body     null -- axios is called with an explicit null body.
#          NO Content-Type is set and NO JSON is sent.
# Timeout  none
# Scope    requires org:create_api_key
#
# CORRECTION vs earlier revisions of this file: this endpoint does NOT
# accept a {"name": "..."} body. The client sends nothing.
#
# Called only on the CONSOLE branch of login (token WITHOUT user:inference).
# If the response has no raw_key the login fails with
# "Unable to create API key. The server accepted the request but did not
#  return a key."

# @name create_api_key
POST {{baseApiUrl}}/api/oauth/claude_cli/create_api_key
Authorization: Bearer {{accessToken}}

### Response:                                           [context]
# { "raw_key": "sk-ant-..." }

### ============================================================================
### 11. CLIENT DATA (remote feature flags)
### ============================================================================
# Verify: rg 'claude_cli/client_data' cli.js
#
# Method   GET                                         [context]
# Headers  Content-Type: application/json
#          User-Agent: claude-code/<version>
#          Authorization: Bearer <token>
#          anthropic-beta: oauth-2025-04-20
# Timeout  5000 ms
# Retry    2 attempts. On a 401 from attempt 1, refresh the token and retry
#          once. Any other error propagates.
# Gates    requires OAuth subscriber (user:inference) AND user:profile.
#          Skipped entirely when CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC set.

# REMOVED IN v2.1.234 -- the path literal is no longer present in the binary.
# Verify: scripts/extract-binary.sh 2.1.234 then grep
# extractions/v2.1.234/raw/paths.txt. Everything above was true through
# v2.1.197 and is kept commented out as history.
# @name get_client_data
# GET {{baseApiUrl}}/api/oauth/claude_cli/client_data
# Authorization: Bearer {{accessToken}}
# anthropic-beta: {{oauthBeta}}
# Content-Type: application/json
# User-Agent: claude-code/{{cliVersion}}

### Response:                                           [context]
# {
#   "client_data": {          // may be null
#     "<flag_name>": "<string value>"
#   }
# }
#
# A flat string->string map. Only `.client_data` is read; the result is
# cached to disk and compared before rewriting. Values are compared as
# strings, e.g. a flag is on when its value === "true".
# Observed key literal: coral_reef_sonnet                [literal]

### ============================================================================
### 12. USAGE / QUOTA
### ============================================================================
# Verify: rg '/api/oauth/usage' cli.js
#
# Method   GET                                         [context]
# Headers  Content-Type: application/json
#          User-Agent: claude-code/<version>
#          Authorization: Bearer <token>
#          anthropic-beta: oauth-2025-04-20
# Timeout  5000 ms
# Gates    requires user:inference AND user:profile.
#          Returns {} without a request if either is missing.
#          Returns null without a request if the token is within the
#          5-minute expiry skew window.
# Trigger  the /usage command and the settings usage panel
#
# CORRECTION: earlier revisions of this file documented an `x-api-key`
# variant of this call. The shared header builder can emit x-api-key, but
# this call site is gated on OAuth-subscriber status, so the API-key branch
# is unreachable here.                                  [absent]

# @name get_usage
GET {{baseApiUrl}}/api/oauth/usage
Authorization: Bearer {{accessToken}}
anthropic-beta: {{oauthBeta}}
Content-Type: application/json
User-Agent: claude-code/{{cliVersion}}

### Response:                                           [context]
# {
#   "five_hour":         { "utilization": 45, "resets_at": "ISO-8601" },
#   "seven_day":         { "utilization": 23, "resets_at": "ISO-8601" },
#   "seven_day_sonnet":  { "utilization": 12, "resets_at": "ISO-8601" },
#   "seven_day_opus":    { "utilization":  5, "resets_at": "ISO-8601" },
#   "extra_usage": {
#     "is_enabled":    true,
#     "used_credits":  1234,     // MINOR UNITS (cents); UI divides by 100
#     "monthly_limit": 5000,     // MINOR UNITS (cents)
#     "utilization":   24
#   }
# }
#
# Each limit block: utilization is a number or null (null -> block hidden);
# resets_at may be absent. Only five_hour, seven_day and seven_day_sonnet
# are rendered by /usage; seven_day_opus appears in rate-limit messaging.
# extra_usage is only rendered for pro/max subscriptions.
#
# Related rate-limit enum used elsewhere in the client  [literal]
# (from response-header parsing, NOT this endpoint's body):
#   five_hour, seven_day, seven_day_opus, seven_day_sonnet, overage

