### 17. ORGANIZATION: EXTRA-USAGE ADMIN REQUESTS
### ============================================================================
# Verify: rg 'admin_requests' cli.js
#
# Shared by all three:                                  [context]
#   Headers  Authorization: Bearer <token>
#            Content-Type: application/json
#            anthropic-version: 2023-06-01
#            x-organization-uuid: <org uuid>
#   NOTE the different header builder: these send anthropic-version and
#   x-organization-uuid, and do NOT send anthropic-beta.
#   The path org uuid and the x-organization-uuid header are always the
#   same value; the caller never passes an org explicitly.
#   Timeout  none. Retry none. No status code is inspected.
#   Auth     OAuth only -- an API key is explicitly rejected upstream with
#            "Claude Code web sessions require authentication with a
#             Claude.ai account."
#
# Gating before any of these fire:                      [context]
#   - DISABLE_EXTRA_USAGE_COMMAND unset
#   - billing_type is one of the four subscription literals (section 8)
#   - subscriptionType is "team" or "enterprise"
#   - user is NOT admin/billing/owner/primary_owner and NOT pro/max
#   Privileged users are sent to a browser URL instead.
#
# Call order: eligibility -> me -> create. Each is independently
# try/caught, so a failed eligibility or lookup does NOT block the POST.
# Trigger: /extra-usage, or the rate-limit options menu.

# @name check_admin_request_eligibility
GET {{baseApiUrl}}/api/oauth/organizations/{{orgUuid}}/admin_requests/eligibility?request_type=limit_increase
Authorization: Bearer {{accessToken}}
Content-Type: application/json
anthropic-version: {{apiVersion}}
x-organization-uuid: {{orgUuid}}

### Response:                                           [context]
# { "is_allowed": boolean }
# Compared with a strict `=== false`. Missing/null is treated as allowed
# -- this check fails OPEN.

###

# @name list_my_admin_requests
# `statuses` repeats once per value. Values are interpolated into the URL
# WITHOUT encoding.
GET {{baseApiUrl}}/api/oauth/organizations/{{orgUuid}}/admin_requests/me?request_type=limit_increase&statuses=pending&statuses=dismissed
Authorization: Bearer {{accessToken}}
Content-Type: application/json
anthropic-version: {{apiVersion}}
x-organization-uuid: {{orgUuid}}

### Response:                                           [context]
# [ ... ]   top-level array; only .length is read, element shape unknown.
# Non-empty -> "You have already submitted a request for extra usage."

###

# @name create_admin_request
POST {{baseApiUrl}}/api/oauth/organizations/{{orgUuid}}/admin_requests
Authorization: Bearer {{accessToken}}
Content-Type: application/json
anthropic-version: {{apiVersion}}
x-organization-uuid: {{orgUuid}}

{
    "request_type": "limit_increase",
    "details": null
}

### Body:                                               [context]
# request_type -- only literal in the bundle is "limit_increase"
# details      -- always sent, always null; non-null shape unknown
### Response: not read by the client.

