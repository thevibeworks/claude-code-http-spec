### ============================================================================
# Verify: rg 'referral/eligibility|referral/redemptions' cli.js
#
# Same header builder as section 17 (anthropic-version +
# x-organization-uuid, no anthropic-beta).             [context]
# Gate: OAuth account with an org uuid AND subscriptionType === "max".
# There is no POST/redeem endpoint -- sharing is a link copied to the
# clipboard, redemption happens outside the CLI.        [absent]

# @name get_referral_eligibility
# Timeout 5000 ms. Result cached 24h per org, stale-while-revalidate,
# in-flight requests deduped. Prefetched at startup unless
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC is set.
GET {{baseApiUrl}}/api/oauth/organizations/{{orgUuid}}/referral/eligibility?campaign=claude_code_guest_pass
Authorization: Bearer {{accessToken}}
Content-Type: application/json
anthropic-version: {{apiVersion}}
x-organization-uuid: {{orgUuid}}

### Response:                                           [context]
# {
#   "eligible":         boolean,
#   "remaining_passes": number | null,
#   "referrer_reward":  { "currency": "USD", "amount_minor_units": 500 } | null,
#   "referral_code_details": {
#     "referral_link": "https://...",
#     "campaign":      "claude_code_guest_pass"
#   }
# }
# Currency symbols the client knows: USD EUR GBP BRL CAD AUD NZD SGD;
# anything else renders as "<CODE> ". amount_minor_units is divided by 100.

###

# @name get_referral_redemptions
# Timeout 10000 ms (double the eligibility call). Not cached -- refetched
# on every /passes invocation. The `campaign` value is echoed from the
# eligibility response's referral_code_details.campaign, defaulting to
# claude_code_guest_pass.
GET {{baseApiUrl}}/api/oauth/organizations/{{orgUuid}}/referral/redemptions?campaign=claude_code_guest_pass
Authorization: Bearer {{accessToken}}
Content-Type: application/json
anthropic-version: {{apiVersion}}
x-organization-uuid: {{orgUuid}}

### Response:                                           [context]
# {
#   "redemptions": [ ... ],   // element shape unknown -- only truthiness
#                             // of redemptions[i] is tested per slot
#   "limit":       3          // client default 3 when falsy; UI renders
#                             // at most 3 regardless
# }

### ============================================================================
### 19. OAUTH FILE TRANSFER
### ============================================================================
# Verify: rg 'api/oauth/file_upload' cli.js
# Verify: rg 'api/oauth/files' cli.js
#
# These two are built from helper hosts, not from the OAuth config's
# BASE_API_URL template, so a naive `BASE_API_URL}/api/` grep misses them.
#
# Host resolution differs between the two:              [context]
#   upload   ANTHROPIC_BASE_URL || BASE_API_URL
#   download BASE_API_URL only -- ANTHROPIC_BASE_URL is IGNORED
# Proxying via ANTHROPIC_BASE_URL therefore splits these two calls across
# two hosts.
#
# Neither sends anthropic-beta nor anthropic-version. Both swallow all
# HTTP errors (validateStatus always true) and log only to debug output.
# The user:file_upload scope is requested but never checked client-side.

# @name upload_file
# Method POST. Timeout 30000 ms. Success is strictly HTTP 201.
# Max size 31457280 bytes (30 MiB), checked BEFORE reading the file;
# oversized files are silently skipped.
# The multipart body is hand-assembled (not FormData) with exactly one
# part named "file". The boundary is `----FormBoundary<randomUUID()>`.
# Per-part Content-Type comes from an extension map with a fallback:
#   .png=image/png  .jpg/.jpeg=image/jpeg  .gif=image/gif  .webp=image/webp
#   anything else = application/octet-stream   (a fallback, not an allowlist)
# Trigger: the SendUserMessage/Brief tool's `attachments`, gated on an
# active REPL bridge session or CLAUDE_CODE_BRIEF_UPLOAD.
POST {{baseApiUrl}}/api/oauth/file_upload
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=----FormBoundary00000000-0000-0000-0000-000000000000

# The client also sets Content-Length explicitly to the assembled buffer's
# byte length. HTTP clients compute this themselves, so it is omitted here.
------FormBoundary00000000-0000-0000-0000-000000000000
Content-Disposition: form-data; name="file"; filename="screenshot.png"
Content-Type: image/png

< ./screenshot.png
------FormBoundary00000000-0000-0000-0000-000000000000--

### Response:                                           [context]
# { "file_uuid": "string" }
# Validated against a schema with exactly that one field; any other
# field the server returns is discarded.

###

# @name download_file
# Method GET. Timeout 30000 ms. Success is strictly HTTP 200.
# Response is read as an arraybuffer -- no JSON, and no response header
# is inspected (Content-Type and Content-Disposition are both ignored).
# No size limit, no streaming, no retry, no cancellation.
# The file_uuid is URL-encoded into the path.
# Written to <config dir>/uploads/<sessionId>/<first-8-of-uuid>-<name>,
# where <name> is the inbound file_name with [^a-zA-Z0-9._-] replaced by
# "_" (falling back to "attachment").
# Trigger: an inbound Remote Control (REPL bridge) message carrying
# file_attachments: [{ file_uuid, file_name }].
GET {{baseApiUrl}}/api/oauth/files/{{fileUuid}}/content
Authorization: Bearer {{accessToken}}

### Response: raw bytes.                                [context]
#
# DO NOT CONFUSE with the public Files API at /v1/files/{id}/content,
# which is a different client: it sends anthropic-version: 2023-06-01 and
# anthropic-beta: files-api-2025-04-14, uses a 60s timeout and retries 3x.

### ============================================================================
### 20. CONNECTIVITY PREFLIGHT
### ============================================================================
# Verify: rg '/api/hello' cli.js
# Verify: rg '/v1/oauth/hello' cli.js
#
# TWO endpoints are probed CONCURRENTLY at startup, and the first failure
# of either aborts the preflight.                       [context]
#   1. {BASE_API_URL}/api/hello
#   2. {origin of TOKEN_URL}/v1/oauth/hello
# The second host is derived from TOKEN_URL, so it follows
# CLAUDE_CODE_CUSTOM_OAUTH_URL when that is set.
#
# Method   GET, no auth
# Headers  User-Agent: claude-cli/<version> (external, <entrypoint>)
#          <- the ONLY header. There is no Cache-Control.
# Timeout  none
# Success  strictly HTTP 200; anything else is
#          "Failed to connect to {hostname}: Status {status}"
# TLS errors are detected separately and surface an SSL hint.
#
# CORRECTION vs earlier revisions of this file: /api/hello does not send
# Cache-Control: no-cache, and it is not the only preflight target.

# @name preflight_api_hello
GET {{baseApiUrl}}/api/hello
User-Agent: claude-cli/{{cliVersion}} (external, cli)

###

# @name preflight_oauth_hello
GET {{platformUrl}}/v1/oauth/hello
User-Agent: claude-cli/{{cliVersion}} (external, cli)

### ============================================================================
### 21. HEADER REFERENCE
### ============================================================================
#
# THREE distinct header builders are used across the OAuth surface.
# Which one applies is stated per endpoint above.       [context]
#
# BUILDER A -- "auth headers" (most /api/oauth/* calls)
#   OAuth mode:    Authorization: Bearer <token>
#                  anthropic-beta:  oauth-2025-04-20
#   API-key mode:  x-api-key: <key>
#                  (no anthropic-beta)
#   Callers add User-Agent and Content-Type themselves; the builder does not.
#
# BUILDER B -- "session headers" (organizations/* calls, sections 17-18)
#   Authorization:       Bearer <token>
#   Content-Type:        application/json
#   anthropic-version:   2023-06-01
#   + x-organization-uuid: <org uuid> added at each call site
#   Never sends anthropic-beta.
#
# BUILDER C -- none. Token exchange, refresh, profile, roles, create_api_key
#   and the file endpoints set their headers inline. Notably:
#     token exchange/refresh -> Content-Type only
#     profile                -> Authorization + Content-Type
#     roles, create_api_key  -> Authorization only
#
# USER-AGENT FORMS -- three exist, and they are not interchangeable:
#   claude-code/<version>
#       plain form; used by client_data, usage, account/settings,
#       grove_notice_viewed, first_token_date
#   claude-code/<version> (<entrypoint>, agent-sdk/<v>, client-app/<v>)
#       parenthesized form; used by the inference client
#   claude-cli/<version> (external, <entrypoint>[, agent-sdk/<v>][, client-app/<v>][, workload/<w>])
#       used by claude_code_grove and by the connectivity preflight
#   <entrypoint> is CLAUDE_CODE_ENTRYPOINT; <workload> is set for cron runs.
#
# Where no User-Agent is set at the call site (profile, roles,
# create_api_key, admin_requests, referral, file endpoints), the HTTP
# client's own default applies -- axios/1.8.4 in v2.1.76.  [context]

### ============================================================================
### 22. LOGIN FLOW SEQUENCE
### ============================================================================
# Verify: rg 'tengu_oauth_flow_start|tengu_oauth_success' cli.js
#
# `claude auth login` / `/login`:                       [context]
#   1. build BOTH authorize URLs (manual + localhost)
#   2. start the local callback server on an ephemeral port
#   3. print the manual URL, open the localhost URL in a browser
#   4. race: whichever callback delivers a code first wins
#   5. POST /v1/oauth/token  (grant_type=authorization_code)
#   6. GET  /api/oauth/profile    -> store account + org identity
#   7. persist tokens to the credential store
#   8. GET  /api/oauth/claude_cli/roles  -> store org/workspace roles
#   9. BRANCH on the granted scopes:
#        has user:inference -> GET /api/organization/claude_code_first_token_date
#        otherwise          -> POST /api/oauth/claude_cli/create_api_key
#  10. if policy sets forceLoginOrgUUID, re-fetch the profile and compare
#      organization.uuid; mismatch fails the login
#
# `claude setup-token`:                                 [context]
#   same as above through step 5, but scope=user:inference and
#   expires_in=31536000. Steps 6-10 are skipped entirely -- the access
#   token is printed for the user to export as CLAUDE_CODE_OAUTH_TOKEN.
#   Such a token has no user:profile scope and cannot pass step 10.
#
# CLI surface:                                          [literal]
#   claude auth login [--email <email>] [--sso]
#   claude auth status [--json|--text]
#   claude auth logout
#   claude setup-token

### ============================================================================
### 23. RECORDED NEGATIVES
### ============================================================================
#
# No token revocation endpoint exists.                  [absent]
#   `claude auth logout` clears local credential storage only. There is no
#   /v1/oauth/revoke call and no RFC 7009 revocation request anywhere in
#   the bundle.
#
# No OAuth discovery for the first-party flow.          [absent]
#   /.well-known/oauth-authorization-server is present in the bundle, but
#   it belongs to the MCP client's own OAuth support, not to Claude Code's
#   login. The first-party endpoints are hardcoded (section 1).
#
# No device-code / client-credentials grant.            [absent]
#   Only authorization_code and refresh_token are sent.
#
# No client_secret anywhere.                            [absent]
#   Public client + PKCE.

### ============================================================================
### 24. LITERALS PRESENT IN LATER BUILDS, NOT YET SPEC'D
### ============================================================================
# Verify: rg 'orgUUID' extractions/v2.1.197/raw/paths.txt
#
# v2.1.139 and later binaries contain a family of quoted route TEMPLATES
# under /api/oauth/organizations/ that use a `:orgUUID` placeholder rather
# than an interpolated value. They are absent from every cli.js-era build
# through v2.1.76, so no call site can be read for them:
#
#   /api/oauth/organizations/:orgUUID/billing/tax_rate
#   /api/oauth/organizations/:orgUUID/claude_code/pro_trial
#   /api/oauth/organizations/:orgUUID/contracts/auto_reload_settings
#   /api/oauth/organizations/:orgUUID/contracts/prepaid/credits
#   /api/oauth/organizations/:orgUUID/overage_credit_grant
#   /api/oauth/organizations/:orgUUID/overage_spend_limit
#   /api/oauth/organizations/:orgUUID/payment_method
#   /api/oauth/organizations/:orgUUID/plugins/list-plugins?enabled_only=true&compact=true
#   /api/oauth/organizations/:orgUUID/prepaid/bundles
#   /api/oauth/organizations/:orgUUID/setup_overage_billing
#   /api/oauth/organizations/:orgUUID/skills/list-skills?include_wiggle_skills=true
#   /api/oauth/organizations/:orgUUID/sync/github/auth
#   /api/hello/:name
#
# Status: [literal] only. Method, headers and bodies are NOT claimed, and
# it is NOT established that the CLI itself calls them -- the `:orgUUID`
# route-parameter style differs from every confirmed CLI call site in this
# file, which interpolates the uuid directly. Per the repo confidence
# model these are recorded, not specified. Resolving them needs a readable
# call site or a newer bundle.
